# Wizard backend configuration. Copy to backend/.env and edit.
# Every value below is a default — the app runs with none of them set.

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_NAME="Wizard"
ENV="dev"                       # dev | prod | test

# auto | laptop | server | hpc.
#
# On auto the machine is measured at boot — physical cores, and installed RAM
# or the container's own cgroup limit — and the resource settings further down
# are derived from it. Naming a profile pins it.
#
# This used to be read by nothing at all: every limit was a constant chosen for
# a server, so a four-core laptop was told to run eight inference threads and to
# allow thirty-two sessions at 2 GB of sandbox each.
SYSTEM_PROFILE="auto"

# ----------------------------------------------------------------------------
# Models
# ----------------------------------------------------------------------------
# API_PROVIDER is the *default* backend: ollama | lmstudio | anthropic | openai |
# gemini | custom_gateway. It is not a lock-in — the UI picks a provider per
# role, so the planner can run on Anthropic while the code model runs on Ollama.
API_PROVIDER=ollama
#
# The three role models are EMPTY by default, which means "use whatever this
# provider actually has installed" — discovered at runtime and picked per role
# by capability. Set one to pin it; you do not need to.
#
# They used to be hardcoded to two Ollama tags, which made those exact models
# load-bearing: neither exists on LM Studio or on a gateway, so switching
# provider failed with a 404 until you also edited this file.
MODEL_NAME=""                   # plans and reasons; empty = auto-select
WORKER_MODEL_NAME=""            # writes the Python; empty = auto-select
VISION_MODEL_NAME=""            # describes charts (only when VISION_ENABLED)
# Left unset on purpose. `host.docker.internal` is how a container reaches its
# host and is the right value inside compose — which passes it itself, so it
# does not need to be here. Outside a container it is a name Docker Desktop
# happens to add to the hosts file: it resolves on a dev machine that has Docker
# and fails outright on one that does not, which is exactly the Docker-less
# install the local execution backend exists to serve. Unset, it is rewritten to
# 127.0.0.1 when the backend is not itself containerised.
# OLLAMA_BASE_URL="http://127.0.0.1:11434"

# LM Studio. Give the root, not the "/v1" endpoint its UI displays — a trailing
# "/v1" is stripped, because discovery also uses the native /api/v0 API.
# Two things to check if the picker stays empty:
#   1. the server is started (LM Studio -> Developer -> Start Server), and
#   2. "Serve on Local Network" is on. LM Studio binds loopback by default, so
#      the backend container cannot reach it otherwise.
# Left unset for the same reason as OLLAMA_BASE_URL above: rewritten to
# 127.0.0.1 automatically when the backend is not containerised.
# LMSTUDIO_BASE_URL="http://127.0.0.1:1234"
LMSTUDIO_API_KEY=""             # LM Studio ignores it; for proxies that don't

# Cloud providers. Keys can also be added from the Models page, which writes them
# to your platform config directory (~/.config/wizard, %APPDATA%\Wizard, or
# ~/Library/Application Support/Wizard) rather than into this file. A value set
# here always wins, so a container or a CI run behaves as it was configured.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
# Only needed to point one of these at a proxy. Empty uses the official endpoint.
# ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"

# Any other OpenAI-compatible endpoint: Groq, OpenRouter, Together, your own
# vLLM. Give the URL including its version segment. (Gemini has its own
# first-class API_PROVIDER=gemini above now, so it no longer needs this route.)
GATEWAY_API_URL=""
GATEWAY_API_KEY=""

# ----------------------------------------------------------------------------
# Data mode — what may leave this machine
# ----------------------------------------------------------------------------
# local-only   every role must resolve to a local provider. A cloud provider is
#              refused outright, not quietly skipped, and web search is off.
# cloud-only   every role resolves to a cloud provider.
# hybrid       you assign a provider per role.
#
# Empty derives it: local-only on a fresh install, cloud-only when API_PROVIDER
# is already a cloud backend — so upgrading an existing install does not break
# it. Each session can change its own mode from the sidebar.
DATA_MODE=""

# Under hybrid or cloud-only, send column names, dtypes, null rates and row
# counts to a cloud model but no real values — no sample rows, no distributions,
# no distinct values. Computed results still reach the model, because the answer
# is written from them. On by default: the conservative option should need no
# decision.
DATA_SCHEMA_ONLY=true

TEMPERATURE=0.0

# MAX_TOKENS is the ceiling for any single call. It is NOT what each call gets:
# the per-purpose budgets below are, and they are what stop a reasoning model
# spending four minutes deciding between "code" and "answer".
MAX_TOKENS=4096
LLM_MAX_TOKENS_PLAN=1024
LLM_MAX_TOKENS_DECISION=512
LLM_MAX_TOKENS_CODE=1536
LLM_MAX_TOKENS_ANSWER=1024
LLM_MAX_TOKENS_REVIEW=256

# Both left unset on purpose — they are derived from the measured machine, and
# a value here overrides that derivation on every machine the file is copied to.
#
#   LLM_NUM_THREAD  physical core count. Local inference is memory-bandwidth
#                   bound, so hyperthreads add contention rather than
#                   throughput; a hardcoded 8 was slower than 4 on a
#                   4-core/8-thread laptop.
#   LLM_NUM_CTX     8192 on a laptop, 16384 on a server, 32768 on an HPC box.
#                   This is a *load-time* parameter: it fixes the KV cache
#                   Ollama reserves for every resident model, so asking for
#                   32k on a 16 GB laptop evicts the worker to make room for
#                   the manager on every single iteration. Prompts here are
#                   budgeted and do not reach 8k. Reaches Ollama only —
#                   OpenAI-compatible servers fix context when the model loads.
# LLM_NUM_THREAD=4
# LLM_NUM_CTX=8192

# How long a provider keeps a model resident after answering. The manager and
# worker alternate all turn; Ollama's own five-minute default can expire inside
# one slow turn, and the reload costs more than the request did.
LLM_KEEP_ALIVE=30m
# Used instead of the above when the manager and worker cannot both fit in this
# machine's memory — each is released after it runs, costing one reload per step
# but never letting two oversized models page each other to disk. It has to be
# short enough to expire while the *other* model is working.
LLM_KEEP_ALIVE_SWAP=30s
# Share of system RAM the models may be planned against; the rest is the OS,
# this backend, the sandbox and your desktop. 0 uses the built-in 0.60. Raise it
# on a machine that does nothing else.
MODEL_MEMORY_FRACTION=0
LLM_REQUEST_TIMEOUT=300
MAX_CORRECTION_RETRIES=3

# ----------------------------------------------------------------------------
# Agentic loop
# ----------------------------------------------------------------------------
# The analysis is an observe → decide → act loop: the agent sees real execution
# output and chooses what to do next, rather than following a plan fixed before
# any data was touched. Each iteration costs one manager round-trip, so the
# budget is scaled to the model behind it.
#
# auto infers the tier from the manager model's parameter count:
#   < 4B  → compact   (short leash, no reflection, no verification pass)
#   4-30B → balanced
#   ≥ 30B → full
# Gateways report no parameter count and are treated as balanced.
AGENT_TIER=auto                 # auto | compact | balanced | full
AGENT_MAX_ITERATIONS=24         # hard ceiling regardless of tier or mode
AGENT_OBSERVATION_CHARS=4000    # execution output carried into the next decision
# Halt for plan approval before running. Off by default — an agent that asks
# permission for every question is not autonomous. This gates the *plan*; the
# profile below gates actions taken within an approved one.
AGENT_REQUIRE_APPROVAL=False
# How much the agent asks before acting: auto-approve | ask-always | custom.
# Orthogonal to depth. Under custom, each category is set from the UI.
AGENT_PERMISSION_PROFILE=ask-always
AGENT_CONSENT_TIMEOUT=120        # seconds a mid-run prompt waits before declining
AGENT_VERIFY=True               # re-derive the headline result a second way
AGENT_GROUNDING_CHECK=True      # refuse numbers absent from real output
AGENT_EMIT_SCRIPT=True          # emit a reproducible script per analysis
# Wall-clock ceiling for one turn. On reaching it the loop stops starting new
# work and answers from what it has, so a slow model degrades into a worse
# answer rather than into no answer. 0 disables it.
AGENT_TURN_TIMEOUT=300

# ----------------------------------------------------------------------------
# Context documents
# ----------------------------------------------------------------------------
# Data dictionaries, metric definitions, business rules. Hard questions usually
# turn on these rather than on the tables alone, so they are ingested alongside
# the datasets, chunked and retrieved during a run.
CONTEXT_DOCS_ENABLED=True
CONTEXT_DOC_MAX_BYTES=33554432  # 32MB
CONTEXT_CHUNK_CHARS=1200
CONTEXT_CHUNK_OVERLAP=150
CONTEXT_TOP_K=5

# ----------------------------------------------------------------------------
# Skills
# ----------------------------------------------------------------------------
# Reusable know-how in the SKILL.md convention, layered built-in (shipped in the
# checkout) / user-global / project-local. Retrieved into the planning prompt and
# by the `consult` action, the same way reference documents are.
#
# A skill is instruction text. It may never ship executable files — the loader
# refuses a skill directory containing one, by name. Code a skill suggests is
# written by the worker and sandboxed like any other generated code.
SKILLS_ENABLED=True
# How many skills may inform one plan, and the whole block's character ceiling.
# The block is built once per turn, for the planner only.
SKILLS_TOP_K=2
SKILLS_MAX_CHARS=1800
SKILLS_MIN_SIMILARITY=0.35
# How many times an analysis must recur before it is offered for promotion into a
# named skill. Nothing is ever written without the user confirming.
SKILL_PROMOTION_THRESHOLD=3
#
# Both directory overrides are left unset on purpose. Empty means "derive it":
# the built-in root is found relative to the checkout, and the project root is
# `.wizard/skills` under the working directory. The user-global root is always
# the platform config directory (%APPDATA%\Wizard, ~/Library/Application
# Support/Wizard, $XDG_CONFIG_HOME/wizard) beside credentials.json — pinning a
# path here would copy one machine's layout onto every machine.
# SKILLS_BUILTIN_DIR=
# SKILLS_PROJECT_DIR=
#
# Installing a skill from a GitHub repository or gist. A pulled skill is pinned
# to the commit it was installed from and never follows a branch; an update is a
# deliberate step that shows the diff first. Nothing installs without the full
# contents being shown for review.
#
# Left commented because api.github.com is right for everyone except a GitHub
# Enterprise install, which is the same API on a hostname only the operator knows.
# SKILLS_REGISTRY_API=https://api.github.com
SKILLS_FETCH_TIMEOUT=20.0
SKILLS_FETCH_MAX_BYTES=262144
SKILLS_FETCH_MAX_FILES=200

# ----------------------------------------------------------------------------
# Where generated code runs
# ----------------------------------------------------------------------------
# host | docker | inprocess
#
#   host       one subprocess per session, running the daemon over a loopback
#              socket. No Docker and no image, and still a separate process — so
#              it keeps its variables between steps, honours the timeout, can be
#              interrupted, and takes a memory cap. This is the default.
#   docker     one container per session. Needs a daemon and a ~700 MB image
#              (see SANDBOX_TIER). Opt-in; if the daemon is unreachable this
#              degrades to host and says so.
#   inprocess  guarded exec inside the API process. No isolation, no persistent
#              namespace. CI and locked-down hosts only.
#
# `auto` and `local` are the pre-w2 spellings of `host` and still work.
EXECUTION_BACKEND=host
HOST_RUNTIME_START_TIMEOUT=60  # first start imports pandas and matplotlib
HOST_RUNTIME_ALLOW_PIP=False   # unlike a container, this installs into YOUR env
# Unset: mirrors SANDBOX_MEM_LIMIT.
# HOST_RUNTIME_MEM_LIMIT="1g"

# ----------------------------------------------------------------------------
# OS sandbox for the host runtime
# ----------------------------------------------------------------------------
# off | best-effort | require
#
#   off          spawn the child with no OS policy applied.
#   best-effort  apply what this OS supports and report the rest. (default)
#   require      refuse to start a runtime that cannot be contained.
#
# Linux uses Landlock + seccomp, macOS a sandbox-exec profile, Windows a job
# object plus a Low integrity level. What each machine can actually enforce is
# on /settings; "Verify" there spawns a probe that tries to escape and reports
# what stopped it.
HOST_SANDBOX=best-effort
# deny | allow — outbound traffic for generated code. Loopback is always
# permitted; the runtime protocol needs it. NOT enforced on Windows, which says
# so rather than claiming otherwise.
HOST_SANDBOX_NETWORK=deny

# ----------------------------------------------------------------------------
# Sandbox
# ----------------------------------------------------------------------------
# core | standard | full — how much of the analysis toolkit the image installs.
# The runtime is asked what it can import and the model is told exactly that, so
# a smaller tier means a smaller advertised toolkit, not code that fails to run.
#
#   core      pandas, numpy, pyarrow, matplotlib, duckdb, openpyxl
#   standard  + scipy, statsmodels, scikit-learn, xgboost-cpu, lightgbm,
#             plotly, seaborn, networkx, pillow, xlsxwriter, tabulate
#   full      + lifelines, geopandas, shapely
SANDBOX_TIER=standard
SANDBOX_IMAGE=""                # empty derives the tag from the tier
# When false, no container is ever created even under EXECUTION_BACKEND=docker.
SANDBOX_ENABLED=True
# False lets the sandbox pip-install a missing package on demand, which needs
# network access. True is more secure but a missing library becomes a hard error.
SANDBOX_NETWORK_DISABLED=False
SANDBOX_DOCKER_RUNTIME=""       # e.g. "runsc" for gVisor kernel isolation
# Unset: an eighth of the machine's RAM, capped at 4g.
# SANDBOX_MEM_LIMIT="2g"
SANDBOX_CPU_QUOTA=0             # 100000 == one CPU; 0 == unlimited
SANDBOX_PIDS_LIMIT=256
SANDBOX_EXEC_TIMEOUT=180        # seconds per execution

# ----------------------------------------------------------------------------
# Output
# ----------------------------------------------------------------------------
PLOT_FORMAT=html                # html = interactive Plotly, png = static image

# ----------------------------------------------------------------------------
# Ingestion limits
# ----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=536870912      # 512MB
MAX_INMEMORY_ROWS=2000000       # beyond this the frame is sampled for analysis
PROFILE_SAMPLE_ROWS=200000      # rows used when profiling a large file
PROMPT_MAX_COLUMNS=60           # wide frames send only the relevant columns

# ----------------------------------------------------------------------------
# Sessions
# ----------------------------------------------------------------------------
SESSION_TTL_SECONDS=21600
# Unset: derived so that concurrent runtimes cannot collectively claim more than
# half of RAM at SANDBOX_MEM_LIMIT each.
# SESSION_MAX_ACTIVE=32
SESSION_HISTORY_TURNS=8

# ----------------------------------------------------------------------------
# Retrieval
# ----------------------------------------------------------------------------
RAG_ENABLED=True
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.35
SEMANTIC_CACHE_THRESHOLD=0.92
TRAJECTORY_MIN_SIMILARITY=0.90

# Embeddings come from the model server you already run — Ollama's
# POST /api/embed, or /v1/embeddings on anything OpenAI-compatible. That costs
# nothing on disk. `sentence-transformers` used to be a hard dependency, and it
# pulls torch, which on linux/x86_64 installs eleven nvidia-*-cu12 wheels
# (~2.8 GB compressed, GPU or not) to run a 90 MB model.
#
# Pull an embedding model to get semantic retrieval — `ollama pull
# embeddinggemma` or `nomic-embed-text`. Without one, matching degrades to word
# overlap and nothing breaks.
EMBEDDINGS_REMOTE_ENABLED=True
EMBEDDING_PROVIDER=""           # empty follows API_PROVIDER
EMBEDDING_REMOTE_MODEL=""       # empty discovers one from that provider
EMBEDDING_TIMEOUT=20.0
# The first call is a different operation: the server has to read the model off
# disk before it can embed anything, which on a cold laptop takes longer than
# any sane steady-state timeout. Judging both by EMBEDDING_TIMEOUT rejected a
# provider that answers in 0.05s once resident, and dropped the whole install to
# lexical retrieval. Affordable because warm-up no longer runs inside a turn.
EMBEDDING_COLD_TIMEOUT=180.0
# Resolve the encoder at startup, in the background, rather than inside the
# first question. Off restores lazy resolution and the cold-start cost with it.
EMBEDDINGS_WARM_ON_STARTUP=True
# Only used if you installed sentence-transformers yourself; see
# requirements-optional.txt, which explains how to avoid the CUDA payload.
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
# Fetch that model if it is missing. Off: a 90 MB download is not something a
# question should trigger, and the provider path above is better anyway.
EMBEDDING_ALLOW_DOWNLOAD=False
# Skip every real encoder and use the hashing one. Air-gapped installs and CI.
EMBEDDINGS_FORCE_FALLBACK=False

# ----------------------------------------------------------------------------
# Review
# ----------------------------------------------------------------------------
COUNCIL_ENABLED=True
COUNCIL_TIMEOUT=20.0
VISION_ENABLED=False            # costs an extra multimodal call per chart

# ----------------------------------------------------------------------------
# Optional Redis (shared cache + job state). Empty = in-process, no service.
# ----------------------------------------------------------------------------
REDIS_URL=""
# Unset: half the physical core count, capped at 4.
# QUEUE_MAX_WORKERS=2
JOB_RESULT_TTL_SECONDS=3600

# ----------------------------------------------------------------------------
# Transport security
# ----------------------------------------------------------------------------
# Comma-separated. "*" is honoured but forces credentials off.
CORS_ALLOW_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# When set, mutating routes require this value in the X-API-Key header.
API_KEY=""
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
WS_MAX_CONCURRENT_PER_IP=4
