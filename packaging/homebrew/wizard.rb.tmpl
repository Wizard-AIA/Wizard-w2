# Do not edit by hand: the next release overwrites this file, and a hand-edited
# checksum is exactly how v1.0.12 shipped a formula that could not install.
class Wizard < Formula
  desc "Local-first autonomous data analysis agent"
  homepage "https://wizardw2.vercel.app/"
  license "BSD-3-Clause"

@ASSETS@

  def install
    # The archive is the whole application (backend/, frontend/, requirements)
    # plus the CLI. It belongs in libexec, not the keg root; the CLI finds it
    # from its own resolved path, so the symlink in bin/ works from anywhere.
    libexec.install Dir["*"]
    bin.install_symlink libexec/"cli/wizard"
  end

  def caveats
    <<~EOS
      Set Wizard up, then start it:

        wizard init
        wizard start

      Then open http://localhost:3000 in your browser.

      To upgrade, use Homebrew, then re-run init (your settings are kept):

        brew update && brew upgrade wizard
        wizard init

      If something looks wrong:  wizard doctor
    EOS
  end

  test do
    assert_match "wizard CLI v#{version}", shell_output("#{bin}/wizard --version")
    assert_match "Usage", shell_output("#{bin}/wizard --help")
  end
end
